{
  "name": "Hello mod",
  "version": "1.0.0",
  "author": "cubefarm",
  "description": "The example mod: a poster over the lobby's waiting chairs, a mascot statue in the lobby, a jukebox song and a little theme. Copy it, change it, make it yours.",
  "kinds": ["props", "posters", "songs", "themes"],
  "props": [
    {
      "id": "mascot",
      "name": "Mascot statue",
      "icon": "🗿",
      "model": "mascot.glb",
      "height": 1.4,
      "footprint": [0.9, 0.9],
      "place": [{ "slot": "lobby-feature" }]
    },
    {
      "id": "mini-cube",
      "name": "Mini mascot",
      "icon": "🧊",
      "shapes": [
        { "shape": "box", "size": [0.16, 0.16, 0.16], "at": [0, 0.08, 0], "color": "#3a86ff" },
        { "shape": "box", "size": [0.03, 0.03, 0.01], "at": [-0.035, 0.1, 0.081], "color": "#1f1d2b" },
        { "shape": "box", "size": [0.03, 0.03, 0.01], "at": [0.035, 0.1, 0.081], "color": "#1f1d2b" },
        { "shape": "box", "size": [0.06, 0.012, 0.01], "at": [0, 0.055, 0.081], "color": "#ff5d8f" },
        { "shape": "sphere", "size": [0.04, 0.04, 0.04], "at": [0, 0.2, 0], "color": "#ff5d8f" }
      ]
    }
  ],
  "posters": [
    {
      "id": "hello-poster",
      "name": "Hello poster",
      "image": "poster.png",
      "width": 1.0,
      "place": [{ "floor": "lobby", "x": 15.97, "z": 7.55, "y": 2.3, "turn": -90 }]
    }
  ],
  "songs": [
    {
      "id": "hello-world-hop",
      "title": "Hello World Hop",
      "artist": "The Example Mods",
      "station": "all",
      "mood": "uplifting",
      "bpm": 112,
      "root": 62,
      "scale": "major",
      "chords": [1, 5, 6, 4],
      "lead": "1 - 3 - 5 - 3 - | 5 - 7, - 2 - 5 - | 6 - 5 - 3 - 1 - | 4 - 3 - 2 - - -",
      "bass": "1 - 5, - 1 - 5, -",
      "comp": ". x . x . x . x",
      "drums": { "kick": "x . . . x . . .", "snare": ". . x . . . x .", "hat": "x x x x x x x x" },
      "sections": {
        "B": { "chords": [4, 1, 5, 1], "lead": "6 - 6 5 4 - 3 - | 3 - 5 - 1' - - - | 7 - 6 - 5 - 2 - | 1 - - - . . . ." }
      },
      "form": "AABA",
      "sound": { "lead": "triangle", "bass": "sine", "chord": "keys" },
      "passes": 3,
      "color": "#3a86ff"
    }
  ],
  "themes": [
    {
      "id": "mod-week",
      "name": "Mod week",
      "emoji": "🧊",
      "dates": { "from": "10-01", "to": "10-07" },
      "decor": [
        { "slots": "desk-*", "item": "mini-cube" },
        { "slots": "qa-*", "item": "mini-cube" },
        { "slots": "reception-*", "item": "mini-cube" }
      ],
      "lights": ["#3a86ff", "#06d6a0", "#ffd166"],
      "tint": { "color": "#bde0fe", "amount": 0.08 },
      "costumes": { "dev": ["partyHat"], "qa": ["partyHat"], "ceo": ["crown"] },
      "greetings": ["🧊 Happy Mod week from the team{name}! There's a mini mascot on every desk."],
      "playlist": ["hello-world-hop"],
      "confetti": { "colors": ["#3a86ff", "#06d6a0", "#ffd166", "#ff5d8f"], "shape": "paper" }
    }
  ]
}
